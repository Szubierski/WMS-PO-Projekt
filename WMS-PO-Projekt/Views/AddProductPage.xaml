<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WmsProdukcja.ViewModels"
             x:Class="WmsProdukcja.Views.AddProductPage"
             x:DataType="vm:AddProductViewModel"
             Title="Nowy Produkt">

    <VerticalStackLayout Spacing="20" Padding="30">
        <Label Text="Dodaj nowy asortyment" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"/>

        <Entry Placeholder="Nazwa produktu (np. Folia Stretch)"
               Text="{Binding Nazwa}"
               ClearButtonVisibility="WhileEditing"/>

        <Label Text="Wybierz typ produktu:" TextColor="Gray"/>
        <Picker ItemsSource="{Binding TypyProduktow}"
                SelectedItem="{Binding WybranyTyp}"
                Title="Kliknij, aby wybrać typ"/>
        <Label Text="Parametry techniczne:" TextColor="Gray" Margin="0,10,0,0"/>
        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Grubość (mm)" FontSize="12"/>
                <Entry Text="{Binding Grubosc}" Keyboard="Numeric" Placeholder="0.00"/>
            </VerticalStackLayout>
    
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Szerokość (m)" FontSize="12"/>
                <Entry Text="{Binding Szerokosc}" Keyboard="Numeric" Placeholder="0.00"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2">
                <Label Text="Długość (m)" FontSize="12"/>
                <Entry Text="{Binding Dlugosc}" Keyboard="Numeric" Placeholder="0.00"/>
            </VerticalStackLayout>
        </Grid>

        <Entry Placeholder="Materiał (np. LDPE, PE)"
               Text="{Binding Material}"
               Margin="0,10,0,0"/>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Zapisz" 
                    Command="{Binding ZapiszCommand}" 
                    BackgroundColor="Green" 
                    WidthRequest="120"/>
            
            <Button Text="Anuluj" 
                    Command="{Binding AnulujCommand}" 
                    BackgroundColor="Gray" 
                    WidthRequest="120"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>