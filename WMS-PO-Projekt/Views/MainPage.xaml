<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WmsProdukcja.ViewModels"
             xmlns:models="clr-namespace:WmsProdukcja.Models"
             x:Class="WmsProdukcja.Views.MainPage"
             x:DataType="vm:MainViewModel">
    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center" Spacing="10" Padding="10">
            <Image Source="icon_warehouse.png" 
                   HeightRequest="24" 
                   WidthRequest="24" 
                   VerticalOptions="Center"/>
            <Label Text="Magazyn WMS" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   TextColor="White"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto, *, Auto" Padding="10" RowSpacing="10">
        
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Lista Produktów"
                   VerticalOptions="Center" 
                   FontAttributes="Bold"
                   FontSize="18"/>
            
            <Button Text="Odśwież" 
                    Command="{Binding ZaladujDaneCommand}"
                    BackgroundColor="#512BD4" 
                    TextColor="White"/>
            
            <Button Text="Eksport XLS" 
                    Command="{Binding EksportujExcelCommand}"
                    BackgroundColor="#107C41" 
                    TextColor="White"/>
            
            <Button Text="Import" 
                    Command="{Binding ImportujExcelCommand}" 
                    BackgroundColor="#E65100" 
                    TextColor="White"
                    HorizontalOptions="Start"/>
            
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#512BD4"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Produkty}"
                        SelectionMode="None">
            
            <CollectionView.Header>
                <Grid ColumnDefinitions="40, *, 180, 100, 120" Padding="5" BackgroundColor="#585858">
                    <Label Text="ID" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="Nazwa" FontAttributes="Bold"/>
                    <Label Grid.Column="2" Text="Typ" FontAttributes="Bold"/>
                    <Label Grid.Column="3" Text="Ilość" FontAttributes="Bold"/>
                    <Label Grid.Column="4" Text="Akcja" FontAttributes="Bold"/>
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Produkt">
                    <Grid ColumnDefinitions="40, *, 180, 100, 120" Padding="10" ColumnSpacing="15">
                        <Label Text="{Binding IdProduktu}" 
                               TextColor="Gray" 
                               VerticalOptions="Center" />

                        <Label Grid.Column="1" 
                               Text="{Binding Nazwa}" 
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center">
                            <ToolTipProperties.Text>
                                <MultiBinding StringFormat="Specyfikacja: {0}mm x {1}m x {2}m | Materiał: {3}">
                                    <Binding Path="Specyfikacje[0].GruboscMm" FallbackValue="0" />
                                    <Binding Path="Specyfikacje[0].SzerokoscM" FallbackValue="0" />
                                    <Binding Path="Specyfikacje[0].DlugoscM" FallbackValue="0" />
                                    <Binding Path="Specyfikacje[0].Material" FallbackValue="-" />
                                </MultiBinding>
                            </ToolTipProperties.Text>
                        </Label>

                        <Label Grid.Column="2" 
                               Text="{Binding TypProduktu}" 
                               HorizontalOptions="Start"
                               TextColor="#AAAAAA"
                               VerticalOptions="Center" />
                        
                        <Label Grid.Column="3" 
                               Text="{Binding StanMagazynowy.AktualnaIlosc, StringFormat='{0} szt.'}" 
                               VerticalOptions="Center"
                               FontAttributes="Bold"/>
                        
                        <Button Grid.Column="4" 
                                Text="Usuń" 
                                BackgroundColor="#FF4500" 
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="White"
                                HeightRequest="30"
                                Padding="0"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=UsunProduktCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Brak danych." HorizontalOptions="Center"/>
                    <Label Text="Kliknij 'Załaduj' aby pobrać z bazy." TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
        </CollectionView>

        <Button Grid.Row="2" 
                Text="+ Dodaj Nowy Produkt" 
                Command="{Binding IdzDoDodawaniaCommand}" 
                BackgroundColor="Green"
                TextColor="White"
                HeightRequest="50"/>
    </Grid>
</ContentPage>