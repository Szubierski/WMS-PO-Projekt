<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WmsProdukcja.ViewModels"
             x:Class="WmsProdukcja.Views.AddProductionPage"
             x:DataType="vm:AddProductionViewModel"
             Title="Nowe Zlecenie">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">
            <Label Text="Zaplanuj Produkcję" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>

            <Label Text="Termin realizacji:" TextColor="White"/>
            <DatePicker Date="{Binding DataRealizacji}"
                        Format="dd.MM.yyyy"/>

            <Label Text="Uwagi do zlecenia:" TextColor="White"/>
            <Editor Placeholder="Np. Dla klienta XYZ, priorytet..."
                    Text="{Binding Uwagi}"
                    HeightRequest="100"
                    BackgroundColor="#F0F0F0"
                    TextColor="Black"/>

            <Button Text="Zatwierdź Zlecenie" 
                    Command="{Binding ZapiszCommand}" 
                    BackgroundColor="Green"
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>